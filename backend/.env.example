# BugFlow Environment Configuration
DEBUG=True
SECRET_KEY=bugflow-insecure-django-dev-secret-key-2026-infosys
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS settings for Ramya's frontend (Vite defaults to 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Set USE_SQLITE=False to connect to PostgreSQL (Docker or local instance)
USE_SQLITE=True
DB_NAME=bugflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
